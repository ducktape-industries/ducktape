<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE plist PUBLIC "-//Apple//DTD PLIST 1.0//EN" "http://www.apple.com/DTDs/PropertyList-1.0.dtd">
<!--
  dev.ducktape.node — one workspace's node, supervised by launchd.

  This file is a TEMPLATE, not a loadable agent: a plist cannot expand `~`,
  `$HOME`, or a workspace selector, so `ops/node/install-macos.sh` substitutes
  the @TOKEN@ placeholders and writes the result into
  ~/Library/LaunchAgents/<label>.plist. Do not `launchctl bootstrap` this file.

  It is the macOS half of ops/node/ducktape-node@.service: a per-user
  LaunchAgent rather than a system daemon, so the node runs as the logged-in
  user with that user's ~/.ducktape, and no root is needed to install it. The
  systemd unit's dedicated `ducktape` user, StateDirectory and sandboxing keys
  have no LaunchAgent equivalent; what does carry over is named below.

  Install, start, stop and log paths: docs/deploy/node-service.md.
-->
<plist version="1.0">
<dict>
  <key>Label</key>
  <string>@LABEL@</string>

  <!-- The LAUNCHER, never the node: `run` starts
       <workspace>/current/ducktape node run, polls it, and follows the
       network's node releases, pinning the release key the network commits
       on its first read. A node started as a bare `ducktape node run`
       follows no release. @WORKSPACE_DIR@ is the workspace directory
       install-macos.sh resolved from the selector; the `#` in a chain id is
       an ordinary character in an argument vector. -->
  <key>ProgramArguments</key>
  <array>
    <string>@LAUNCHER_BIN@</string>
    <string>run</string>
    <string>--workspace</string>
    <string>@WORKSPACE_DIR@</string>
    <string>--config</string>
    <string>@WORKSPACE_DIR@/node.toml</string>
  </array>

  <key>EnvironmentVariables</key>
  <dict>
    <!-- Everything the node keeps on disk lives here, one directory per
         network (<chain-id>/ with its keys/, guest/, executors/ and state);
         `~/.ducktape` when the installer was not told otherwise. -->
    <key>DUCKTAPE_HOME</key>
    <string>@DUCKTAPE_HOME@</string>
    <key>RUST_LOG</key>
    <string>@RUST_LOG@</string>
    <!-- launchd hands a job a minimal PATH and no login shell, so the Homebrew
         prefixes the sandbox's tool lookup uses are added explicitly. -->
    <key>PATH</key>
    <string>@PATH@</string>
  </dict>

  <key>WorkingDirectory</key>
  <string>@DUCKTAPE_HOME@</string>

  <key>RunAtLoad</key>
  <true/>
  <!-- The unit's Restart=always. launchd will not respawn a job more often
       than ThrottleInterval seconds, which is also its RestartSec=3. -->
  <key>KeepAlive</key>
  <true/>
  <key>ThrottleInterval</key>
  <integer>3</integer>

  <!-- launchd stops a job with SIGTERM and escalates to SIGKILL after this
       many seconds. The launcher passes SIGTERM to its node and gives it
       120 s to checkpoint before its own SIGKILL, so launchd waits longer,
       as the unit's TimeoutStopSec does. A validator and a resident alike
       take the graceful path on SIGTERM — a final checkpoint, then one
       `node_shutdown` line (bin/node/src/drain_actions.rs). A hard kill
       lands on WAL-forward recovery instead. -->
  <key>ExitTimeOut</key>
  <integer>150</integer>

  <!-- The node's own raise targets 65536 and is clamped to the lower of this
       hard limit and `kern.maxfilesperproc`
       (crates/kernel/node/src/resource_limits.rs), so the hard limit is what
       the raise may reach. The soft limit is a floor: a GUI-launched process
       inherits 256, which the module stores blow past into a bare EMFILE, and
       10240 keeps the process well above the 4096 the node reports as the
       minimum it can live on even if the raise itself refuses. -->
  <key>SoftResourceLimits</key>
  <dict>
    <key>NumberOfFiles</key>
    <integer>10240</integer>
  </dict>
  <key>HardResourceLimits</key>
  <dict>
    <key>NumberOfFiles</key>
    <integer>65536</integer>
  </dict>

  <!-- Unset (or `Standard`) means launchd throttles the job's CPU and I/O
       bandwidth, which a validator cannot bear: it must vote every block. -->
  <key>ProcessType</key>
  <string>Interactive</string>

  <!-- The node logs through tracing to stderr, and the workspace's own
       daemon.log is tee'd from the same stream; stdout catches whatever the
       process prints outside it. Nothing rotates these two files — launchd has
       no equivalent of the unit's logrotate drop-in, so truncate them yourself
       if they grow (the workspace daemon.log is the copy to keep). -->
  <key>StandardOutPath</key>
  <string>@LOG_DIR@/node.out.log</string>
  <key>StandardErrorPath</key>
  <string>@LOG_DIR@/node.err.log</string>
</dict>
</plist>
