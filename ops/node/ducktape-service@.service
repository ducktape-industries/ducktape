# ducktape-service@<kind> — one first-party service daemon, supervised by
# ducktape-node-launcher's service role.
#
# The instance is the kind `ducktape service run` takes: compute, agent or
# airlock. The daemon signals to the node over its loopback HTTP surface and
# serves the plane the kind names. Enabling this unit IS the consent: the
# daemon runs with `--enable`, which mints its grant (`services.toml`)
# without asking.
#
# The unit runs the LAUNCHER, never the daemon: `service` waits until the node
# has published its mesh identity (a daemon started before that exits fatal),
# then starts `<workspace>/current/ducktape service run <kind>`, and restarts
# it when a node release flips `current` — so the node and its daemons change
# build together. The workspace is DUCKTAPE_WORKSPACE, which
# `ops/node/install.sh` writes to /etc/ducktape/workspace.env; the launcher
# appends `--config` itself, so DUCKTAPE_SERVICE_ARGS must not name a
# workspace again.
#
# Once serving, the daemon rides out a node restart on its own (its link
# re-dials forever and its hello heartbeat keeps signaling). To order it
# after one node, add a drop-in:
#   systemctl edit ducktape-service@compute
#   [Unit]
#   After=ducktape-node@<escaped chain id>.service
#   BindsTo=ducktape-node@<escaped chain id>.service
#
# The daemon logs to <workspace>/<kind>.log (tee'd from stderr).
[Unit]
Description=Ducktape service daemon (%i)
Documentation=https://github.com/orthory/ducktape/blob/dev/docs/deploy/node-service.md
After=network-online.target
Wants=network-online.target

[Service]
User=ducktape
Group=ducktape
# compute and agent boot a Firecracker microVM per run over /dev/kvm.
SupplementaryGroups=kvm
StateDirectory=ducktape
StateDirectoryMode=0700
WorkingDirectory=/var/lib/ducktape
# the per-run vsock socket dir — short on purpose (SUN_LEN).
RuntimeDirectory=ducktape-service/%i
Environment=DUCKTAPE_HOME=/var/lib/ducktape
Environment=XDG_RUNTIME_DIR=/run/ducktape-service/%i
# DUCKTAPE_WORKSPACE=/var/lib/ducktape/<chain-id> — required, written by
# ops/node/install.sh.
EnvironmentFile=/etc/ducktape/workspace.env
EnvironmentFile=-/etc/ducktape/node.env
ExecStart=/usr/local/bin/ducktape-node-launcher service --workspace ${DUCKTAPE_WORKSPACE} --config ${DUCKTAPE_WORKSPACE}/node.toml -- service run %i --enable $DUCKTAPE_SERVICE_ARGS
# SIGTERM is the daemon's teardown path (it retracts its gateway route). It
# reaches the LAUNCHER only (KillMode=mixed), which passes it to the daemon
# and waits for it.
KillSignal=SIGTERM
KillMode=mixed
TimeoutStopSec=60
Restart=always
RestartSec=5
LimitNOFILE=65536

# ---- least privilege: ducktape-node@'s posture plus the microVM grants ----
NoNewPrivileges=yes
CapabilityBoundingSet=
AmbientCapabilities=
ProtectSystem=strict
ProtectHome=yes
# Run images live under TMPDIR and are as large as a run's inputs; keep
# /tmp private, and point TMPDIR at a disk with room via node.env if /tmp
# is tmpfs.
PrivateTmp=yes
# NOT PrivateDevices: compute and agent open /dev/kvm per run. `closed` keeps
# the standard pseudo devices (null, zero, urandom, ptmx) and nothing else.
DevicePolicy=closed
DeviceAllow=/dev/kvm rw
ProtectProc=invisible
ProtectKernelTunables=yes
ProtectKernelModules=yes
ProtectKernelLogs=yes
ProtectControlGroups=yes
ProtectClock=yes
ProtectHostname=yes
LockPersonality=yes
RestrictRealtime=yes
RestrictSUIDSGID=yes
RestrictAddressFamilies=AF_UNIX AF_INET AF_INET6 AF_NETLINK
SystemCallArchitectures=native
UMask=0077

[Install]
WantedBy=multi-user.target
