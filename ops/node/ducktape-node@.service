# ducktape-node@<chain-id> — one workspace's node, supervised by
# ducktape-node-launcher.
#
# The instance is the workspace DIRECTORY under DUCKTAPE_HOME, which is the
# network's full chain id (`ducktape node list`). A chain id carries `#`,
# which a unit name cannot, so escape it:
# `systemctl start "ducktape-node@$(systemd-escape 'mynet#d0cdf950')"`.
# `%I` below is the UNESCAPED instance, so it names the directory again.
#
# The unit runs the LAUNCHER, never the node: `run` starts
# `<workspace>/current/ducktape node run`, polls it, and follows the network's
# node releases — stage, qualify, flip, roll back — pinning the release key
# the network commits on its first read. `ops/node/install.sh` seeds
# `<workspace>/current` with `ducktape-node-launcher install` before the unit
# first starts; the launcher refuses a workspace with no install
# (`state_missing`). A node started as a bare `ducktape node run` follows no
# release, and no later node release can reach it.
#
# Everything the node keeps lives under DUCKTAPE_HOME (/var/lib/ducktape, the
# StateDirectory), one directory per network and nothing else:
# <chain-id>/{node.toml,network.toml,identity.key,keys/,guest/,executors/,
# capabilities/,storage/,updates/,current,daemon.log}. The founding set rides
# with each release (`current/modules/`, beside the binary that reads it), so
# a flip moves the binary and its set together. See
# docs/deploy/node-service.md for install, ports, logs and backup.
#
# Hardening mirrors ops/coordinator/ducktape-coordinator.service where the
# node can bear it. The differences are deliberate, and each is named below:
# the node holds a key and writes state, and runs wasm through a JIT. It
# never opens /dev/kvm or boots a microVM — that is the service daemons' job
# (ducktape-service@), whose unit carries the device grant.
[Unit]
Description=Ducktape node (%I)
Documentation=https://github.com/orthory/ducktape/blob/dev/docs/deploy/node-service.md
After=network-online.target
Wants=network-online.target

[Service]
User=ducktape
Group=ducktape
# /var/lib/ducktape, created and chowned by systemd; DUCKTAPE_HOME is where
# the workspaces live. No DUCKTAPE_MODULES_DIR: a node resolves its founding
# set (the netstack guest it reads at boot) beside its own binary, and every
# release the launcher installs carries one there — a directory named here
# would outrank the set each later release brings. A network's own wasm is its
# workspace `genesis` file.
StateDirectory=ducktape
StateDirectoryMode=0700
WorkingDirectory=/var/lib/ducktape
Environment=DUCKTAPE_HOME=/var/lib/ducktape
# Optional: RUST_LOG, extra `node run` flags in DUCKTAPE_NODE_ARGS. The file
# is not required.
EnvironmentFile=-/etc/ducktape/node.env
ExecStart=/usr/local/bin/ducktape-node-launcher run --workspace /var/lib/ducktape/%I --config /var/lib/ducktape/%I/node.toml -- $DUCKTAPE_NODE_ARGS
# SIGTERM reaches the LAUNCHER only (KillMode=mixed), which stops its node the
# way a flip does: SIGTERM, then up to 120 s to checkpoint, then SIGKILL. A
# validator and a resident alike take the graceful path — a final checkpoint,
# then one `node_shutdown` line (bin/node/src/drain_actions.rs). systemd's own
# SIGKILL comes after the launcher's budget, never before it.
KillSignal=SIGTERM
KillMode=mixed
TimeoutStopSec=150
Restart=always
RestartSec=3
# 77: the join gate refused this workspace's invite, so it can never redeem
# (`app_update::release_status::EXIT_INVITE_UNREDEEMABLE`). The node exits
# with it, the launcher stops with it, and a restart would only ask the same
# question again — so systemd leaves the unit failed. Join again with a fresh
# invite, then start the unit.
RestartPreventExitStatus=77
# The node raises its own soft limit to 65536; the hard limit must allow it.
LimitNOFILE=65536

# ---- least privilege ----------------------------------------------------
NoNewPrivileges=yes
# The node needs no capability: every listener is above 1024
# (8844/8845/8846/51820/51821) and the WireGuard plane is userspace.
CapabilityBoundingSet=
AmbientCapabilities=
# Writable: the state dir only (systemd adds it).
ProtectSystem=strict
ProtectHome=yes
PrivateTmp=yes
# `node run` opens no device beyond the standard pseudo set; /dev/kvm and the
# microVMs belong to ducktape-service@.
PrivateDevices=yes
ProtectProc=invisible
ProtectKernelTunables=yes
ProtectKernelModules=yes
ProtectKernelLogs=yes
ProtectControlGroups=yes
ProtectClock=yes
ProtectHostname=yes
LockPersonality=yes
RestrictRealtime=yes
RestrictSUIDSGID=yes
# NOT MemoryDenyWriteExecute: wasmtime JIT-compiles module code.
# AF_UNIX for glibc's own lookups (nscd/nss); AF_NETLINK for interface
# enumeration (getifaddrs) the reachability plane needs.
RestrictAddressFamilies=AF_UNIX AF_INET AF_INET6 AF_NETLINK
SystemCallArchitectures=native
# No SystemCallFilter / RestrictNamespaces: neither was ever exercised under
# the node. Add them only after a boot and a served block have been observed
# under them.
UMask=0077

[Install]
WantedBy=multi-user.target
