# ducktape-node-user@<workspace> — one workspace's node under the operator's
# own systemd (`systemctl --user`), supervised by ducktape-node-launcher. The
# rootless twin of ducktape-node@: no root, no service user, and the node
# survives a logout and a reboot once linger is on
# (`loginctl enable-linger "$USER"`).
#
# The instance is the workspace DIRECTORY under ~/.ducktape, which is the
# network's full chain id (`ducktape node list`). A chain id carries `#`,
# which a unit name cannot, so escape it:
# `systemctl --user start "ducktape-node-user@$(systemd-escape 'mynet#d0cdf950')"`.
# `%I` below is the UNESCAPED instance, so it names the directory again.
#
# `ops/node/install.sh --user --workspace <name>` installs this unit, copies
# the launcher to <workspace>/ducktape-node-launcher and starts it. The
# workspace must already be under the launcher (`updates/state.json`, written
# by `ducktape-node-launcher install`); the launcher refuses one that is not
# (`state_missing`). No DUCKTAPE_MODULES_DIR: a node resolves its founding set
# beside its own binary, and every release the launcher installs carries one
# there — a directory named here would outrank the set each later release
# brings.
#
# The launcher and its node log to <workspace>/launcher.log; the node also
# writes <workspace>/daemon.log. See docs/deploy/node-service.md.
[Unit]
Description=Ducktape node under its launcher (%I)
Documentation=https://github.com/orthory/ducktape/blob/dev/docs/deploy/node-service.md
After=network-online.target

[Service]
ExecStart=%h/.ducktape/%I/ducktape-node-launcher run --workspace %h/.ducktape/%I --config %h/.ducktape/%I/node.toml
StandardOutput=append:%h/.ducktape/%I/launcher.log
StandardError=append:%h/.ducktape/%I/launcher.log
# SIGTERM reaches the LAUNCHER only (KillMode=mixed), which stops its node the
# way a flip does: SIGTERM, then up to 120 s to checkpoint, then SIGKILL.
# systemd's own SIGKILL comes after the launcher's budget, never before it.
KillSignal=SIGTERM
KillMode=mixed
TimeoutStopSec=150
Restart=always
RestartSec=3
# 77: the join gate refused this workspace's invite, so it can never redeem
# (`app_update::release_status::EXIT_INVITE_UNREDEEMABLE`). The launcher stops
# with it, and systemd leaves the unit failed. Join again with a fresh invite,
# then start the unit.
RestartPreventExitStatus=77
# The node raises its own soft limit to 65536; the hard limit must allow it.
LimitNOFILE=65536

[Install]
WantedBy=default.target
