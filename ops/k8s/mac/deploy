#!/usr/bin/env bash
# Builds the mac relay's image around the ducktape CLI built from the source of DUCKTAPE_COMMIT and git-remote-duck, pushes it to the cluster node's registry, and applies mac.yaml.
# Usage: ops/k8s/mac/deploy FORGE DUCKTAPE_COMMIT
set -euo pipefail
here="$(cd -- "$(dirname -- "${BASH_SOURCE[0]}")" && pwd)"
usage="usage: ops/k8s/mac/deploy FORGE DUCKTAPE_COMMIT"
forge=${1:?$usage}
commit=$(git -C "$here" rev-parse --verify "${2:?$usage}^{commit}")
node=${DEPLOY_NODE:-fabrics@fabrics-1}
context=${DEPLOY_CONTEXT:-fabrics-1}
tunnel_port=35313

stage=$(mktemp -d)
socket="$stage.ssh"
trap 'ssh -S "$socket" -O exit "$node" 2>/dev/null; rm -rf "$stage"' EXIT
mkdir "$stage/src"
git -C "$(git -C "$here" rev-parse --show-toplevel)" archive "$commit" | tar -x -C "$stage/src"
duck_release=$("$here/../git-remote-duck" "$stage/git-remote-duck")
cp "$here/relay.py" "$stage/relay.py"
tag=$(cat "$here/Containerfile" "$stage/relay.py" <(echo "$commit $duck_release") | sha256sum | cut -c1-12)
nice -n 19 podman build --file "$here/Containerfile" --build-arg COMMIT="$commit" \
  --tag "localhost:$tunnel_port/mac:$tag" "$stage"
ssh -fN -M -S "$socket" -o ExitOnForwardFailure=yes -L "127.0.0.1:$tunnel_port:127.0.0.1:5000" "$node"
podman push --tls-verify=false --digestfile "$stage/digest" "localhost:$tunnel_port/mac:$tag"
image="localhost:5000/mac:$tag@$(cat "$stage/digest")"
sed -e "s#@IMAGE@#$image#g" -e "s#@FORGE@#$forge#g" \
  "$here/mac.yaml" | kubectl --context "$context" apply -f -
kubectl --context "$context" -n mac rollout status deployment/mac
echo "$image"
