#!/usr/bin/env bash
# Builds the node image from the source of a ducktape commit, pushes it to the cluster node's registry, and applies a network's node and tunnel.
# Usage: [HOST=IP [HTTP_PORT=8844] [HALO_PORT=9100]] ops/k8s/deploy NETWORK COMMIT [--found]
set -euo pipefail
here="$(cd -- "$(dirname -- "${BASH_SOURCE[0]}")" && pwd)"
usage="usage: [HOST=IP [HTTP_PORT=8844] [HALO_PORT=9100]] ops/k8s/deploy NETWORK COMMIT [--found]"
network=${1:?$usage}
commit=$(git -C "$here" rev-parse --verify "${2:?$usage}^{commit}")
mode=${3:-}
node=${DEPLOY_NODE:-fabrics@fabrics-1}
tunnel_port=35311
tag=${commit:0:12}
host=${HOST:-}
http_port=${HTTP_PORT:-8844}
halo_port=${HALO_PORT:-9100}

stage=$(mktemp -d)
socket="$stage.ssh"
trap 'ssh -S "$socket" -O exit "$node" 2>/dev/null; rm -rf "$stage"' EXIT
mkdir "$stage/src"
git -C "$(git -C "$here" rev-parse --show-toplevel)" archive "$commit" | tar -x -C "$stage/src"
nice -n 19 podman build --file "$here/Containerfile" --build-arg COMMIT="$commit" \
  --tag "localhost:$tunnel_port/ducktape:$tag" "$stage"
ssh -fN -M -S "$socket" -o ExitOnForwardFailure=yes -L "127.0.0.1:$tunnel_port:127.0.0.1:5000" "$node"
podman push --tls-verify=false --digestfile "$stage/digest" "localhost:$tunnel_port/ducktape:$tag"
image="localhost:5000/ducktape:$tag@$(cat "$stage/digest")"

render() {
  sed -e "s#NETWORK#$network#g" -e "s#image: IMAGE\$#image: $image#" "$here/$1"
}
bind() {
  case $host in
    "") cat ;;
    *) sed -e "s#containerPort: 8844}#containerPort: 8844, hostIP: $host, hostPort: $http_port}#" \
         -e "s#containerPort: 9100, protocol: UDP}#containerPort: 9100, protocol: UDP, hostIP: $host, hostPort: $halo_port}#" ;;
  esac
}
render network.yaml | kubectl apply -f -
case $mode in
  --found)
    render found.yaml | kubectl apply -f -
    kubectl -n "$network" wait pod/found --for=condition=Ready --timeout=5m
    ;;
  "")
    tunnel=$(kubectl -n "$network" get secret tunnel --ignore-not-found -o name)
    if [ -n "$tunnel" ]; then render tunnel.yaml | kubectl apply -f -; fi
    render node.yaml | bind | kubectl apply -f -
    if [ -n "$tunnel" ]; then kubectl -n "$network" rollout status deployment/tunnel --timeout=5m; fi
    kubectl -n "$network" rollout status deployment/node --timeout=5m
    ;;
  *)
    echo "deploy: unknown mode $mode" >&2
    exit 1
    ;;
esac
