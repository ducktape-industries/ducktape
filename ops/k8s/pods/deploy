#!/usr/bin/env bash
# Builds the pods service image around a released ducktape CLI and git-remote-duck, pushes it to the cluster node's registry, and applies pods.yaml.
# Usage: AGENTS_CPU=CPU AGENTS_MEMORY=MEMORY ops/k8s/pods/deploy NODE_URL FORGE DUCKTAPE_COMMIT
# DUCKTAPE_COMMIT names a GitHub release bin-DUCKTAPE_COMMIT; a dev commit has none, so give the one the network's node runs.
set -euo pipefail
here="$(cd -- "$(dirname -- "${BASH_SOURCE[0]}")" && pwd)"
usage="usage: AGENTS_CPU=CPU AGENTS_MEMORY=MEMORY ops/k8s/pods/deploy NODE_URL FORGE DUCKTAPE_COMMIT"
node_url=${1:?$usage}
forge=${2:?$usage}
commit=$(git -C "$here" rev-parse --verify "${3:?$usage}^{commit}")
agents_cpu=${AGENTS_CPU:?AGENTS_CPU is the requests.cpu of hardcap: the allocatable cpu of the node minus the requests of the duckpond node, ccs and tunnel pods (kubectl describe node)}
agents_memory=${AGENTS_MEMORY:?AGENTS_MEMORY is the requests.memory of hardcap: the allocatable memory of the node minus the requests of those pods}
node=${DEPLOY_NODE:-fabrics@fabrics-1}
context=${DEPLOY_CONTEXT:-fabrics-1}
kubectl_version=v1.36.5
duck_release=git-remote-duck-7acf453
duck_sha256=c03d7b0d02327af0a1d8eef2d80e778ec8a67850aa42dd2b43022f85269b5b75
tunnel_port=35312

stage=$(mktemp -d)
socket="$stage.ssh"
trap 'ssh -S "$socket" -O exit "$node" 2>/dev/null; rm -rf "$stage"' EXIT
gh release download "bin-$commit" -R ducktape-industries/ducktape \
  -p ducktape-x86_64-unknown-linux-gnu.tar.gz -D "$stage"
tar -xzf "$stage/ducktape-x86_64-unknown-linux-gnu.tar.gz" -C "$stage"
curl -fsSL -o "$stage/kubectl" "https://dl.k8s.io/release/$kubectl_version/bin/linux/amd64/kubectl"
echo "$(curl -fsSL "https://dl.k8s.io/release/$kubectl_version/bin/linux/amd64/kubectl.sha256")  $stage/kubectl" | sha256sum --check --quiet
curl -fsSL -o "$stage/git-remote-duck" \
  "https://github.com/ducktape-industries/ducktape/releases/download/$duck_release/git-remote-duck-x86_64-unknown-linux-gnu"
echo "$duck_sha256  $stage/git-remote-duck" | sha256sum --check --quiet
chmod +x "$stage/kubectl" "$stage/git-remote-duck"
cp "$here/server.py" "$stage/server.py"
tag=$(cat "$here/Containerfile" "$stage/server.py" <(echo "$commit $kubectl_version $duck_release") | sha256sum | cut -c1-12)
podman build --file "$here/Containerfile" --tag "localhost:$tunnel_port/pods:$tag" "$stage"
ssh -fN -M -S "$socket" -o ExitOnForwardFailure=yes -L "127.0.0.1:$tunnel_port:127.0.0.1:5000" "$node"
podman push --tls-verify=false --digestfile "$stage/digest" "localhost:$tunnel_port/pods:$tag"
image="localhost:5000/pods:$tag@$(cat "$stage/digest")"
sed -e "s#@IMAGE@#$image#g" -e "s#@NODE_URL@#$node_url#g" -e "s#@FORGE@#$forge#g" \
  -e "s#@AGENTS_CPU@#$agents_cpu#g" -e "s#@AGENTS_MEMORY@#$agents_memory#g" \
  "$here/pods.yaml" | kubectl --context "$context" apply -f -
kubectl --context "$context" -n pods rollout status deployment/pods
echo "$image"
