#!/usr/bin/env bash
# Builds the pods service image around the ducktape CLI built from the source of DUCKTAPE_COMMIT and git-remote-duck, pushes it to the cluster node's registry, and applies pods.yaml with hardcap computed from the live cluster.
# Usage: ops/k8s/pods/deploy NODE_URL FORGE DUCKTAPE_COMMIT
set -euo pipefail
here="$(cd -- "$(dirname -- "${BASH_SOURCE[0]}")" && pwd)"
usage="usage: ops/k8s/pods/deploy NODE_URL FORGE DUCKTAPE_COMMIT"
node_url=${1:?$usage}
forge=${2:?$usage}
commit=$(git -C "$here" rev-parse --verify "${3:?$usage}^{commit}")
node=${DEPLOY_NODE:-fabrics@fabrics-1}
context=${DEPLOY_CONTEXT:-fabrics-1}

hardcap() {
  {
    kubectl --context "$context" get nodes \
      -o jsonpath='{range .items[*]}+ 1 {.status.allocatable.cpu}/{.status.allocatable.memory}{"\n"}{end}' &&
      kubectl --context "$context" -n duckpond get deployment node ccs tunnel \
        -o jsonpath='{range .items[*]}- {.spec.replicas}{range .spec.template.spec.containers[*]} {.resources.requests.cpu}/{.resources.requests.memory}{end}{"\n"}{end}'
  } | awk '
    BEGIN {
      scale[""] = 1
      split("Ki Mi Gi Ti Pi", binary, " ")
      split("k M G T P", decimal, " ")
      for (i = 1; i <= 5; i++) { scale[binary[i]] = 1024 ^ i; scale[decimal[i]] = 1000 ^ i }
    }
    function millicores(q) { return q ~ /m$/ ? substr(q, 1, length(q) - 1) : q * 1000 }
    function bytes(q) { return match(q, /^[0-9.]+/) ? substr(q, 1, RLENGTH) * scale[substr(q, RLENGTH + 1)] : 0 }
    {
      sign = $1 == "+" ? 1 : -1
      for (i = 3; i <= NF; i++) {
        split($i, request, "/")
        cpu += sign * $2 * millicores(request[1])
        memory += sign * $2 * bytes(request[2])
      }
    }
    END { printf "%dm %dKi\n", cpu, memory / 1024 }
  '
}
limits=$(hardcap)
read -r agents_cpu agents_memory <<<"$limits"
echo "hardcap: requests.cpu $agents_cpu, requests.memory $agents_memory"
kubectl_version=v1.36.5
tunnel_port=35312

stage=$(mktemp -d)
socket="$stage.ssh"
trap 'ssh -S "$socket" -O exit "$node" 2>/dev/null; rm -rf "$stage"' EXIT
mkdir "$stage/src"
git -C "$(git -C "$here" rev-parse --show-toplevel)" archive "$commit" | tar -x -C "$stage/src"
curl -fsSL -o "$stage/kubectl" "https://dl.k8s.io/release/$kubectl_version/bin/linux/amd64/kubectl"
echo "$(curl -fsSL "https://dl.k8s.io/release/$kubectl_version/bin/linux/amd64/kubectl.sha256")  $stage/kubectl" | sha256sum --check --quiet
duck_release=$("$here/../git-remote-duck" "$stage/git-remote-duck")
chmod +x "$stage/kubectl"
cp "$here/server.py" "$stage/server.py"
tag=$(cat "$here/Containerfile" "$stage/server.py" <(echo "$commit $kubectl_version $duck_release") | sha256sum | cut -c1-12)
nice -n 19 podman build --file "$here/Containerfile" --build-arg COMMIT="$commit" \
  --tag "localhost:$tunnel_port/pods:$tag" "$stage"
ssh -fN -M -S "$socket" -o ExitOnForwardFailure=yes -L "127.0.0.1:$tunnel_port:127.0.0.1:5000" "$node"
podman push --tls-verify=false --digestfile "$stage/digest" "localhost:$tunnel_port/pods:$tag"
image="localhost:5000/pods:$tag@$(cat "$stage/digest")"
sed -e "s#@IMAGE@#$image#g" -e "s#@NODE_URL@#$node_url#g" -e "s#@FORGE@#$forge#g" \
  -e "s#@AGENTS_CPU@#$agents_cpu#g" -e "s#@AGENTS_MEMORY@#$agents_memory#g" \
  "$here/pods.yaml" | kubectl --context "$context" apply -f -
kubectl --context "$context" -n pods rollout status deployment/pods
echo "$image"
