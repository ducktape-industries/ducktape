# The node image: ducktape built from the source of one forge commit, run on Debian, home at /data.
# Built by ops/k8s/deploy from a staged context holding `git archive` of that commit under src/.
FROM docker.io/library/rust:1.96.1-trixie AS build
WORKDIR /src
COPY src/ .
RUN cargo build --locked --release -p node-bin

FROM docker.io/library/debian:trixie-slim
ARG COMMIT
LABEL org.opencontainers.image.revision=$COMMIT
RUN apt-get update && apt-get install -y --no-install-recommends ca-certificates \
    && rm -rf /var/lib/apt/lists/* \
    && useradd --uid 1000 --user-group --no-create-home --home-dir /data ducktape
COPY --from=build /src/target/release/ducktape /usr/local/bin/ducktape
ENV DUCKTAPE_HOME=/data NO_COLOR=1
USER 1000:1000
ENTRYPOINT ["ducktape"]
CMD ["run", "--listen", "127.0.0.1:9000", "--http", "0.0.0.0:8844", "--halo", "0.0.0.0:9100"]
