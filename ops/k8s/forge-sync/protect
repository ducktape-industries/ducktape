#!/usr/bin/env bash
# Moves the classic branch protection of dev in ducktape, programs and app, and of app's main, into repository rulesets with the same rules, adding the forge-sync GitHub App to the bypass lists.
# Usage: ops/k8s/forge-sync/protect APP_ID [--apply]; without --apply it prints each ruleset and the classic protection it replaces.
set -euo pipefail
usage="usage: ops/k8s/forge-sync/protect APP_ID [--apply]"
app_id=${1:?$usage}
apply=${2:-}
org=ducktape-industries
actions_app=15368

ruleset() {
  local name=$1 branches=$2 rules=$3 bypass=$4
  jq -n --arg name "$name" --argjson branches "$branches" --argjson rules "$rules" --argjson bypass "$bypass" '{
    name: $name,
    target: "branch",
    enforcement: "active",
    conditions: {ref_name: {include: [$branches[] | "refs/heads/\(.)"], exclude: []}},
    rules: $rules,
    bypass_actors: $bypass
  }'
}

unit_rules=$(jq -n --argjson app "$actions_app" '[{type: "required_status_checks", parameters: {
  strict_required_status_checks_policy: false,
  do_not_enforce_on_create: false,
  required_status_checks: [{context: "unit", integration_id: $app}]
}}]')
admins_and_follower=$(jq -n --argjson app "$app_id" '[
  {actor_id: 5, actor_type: "RepositoryRole", bypass_mode: "always"},
  {actor_id: 1, actor_type: "OrganizationAdmin", bypass_mode: "always"},
  {actor_id: $app, actor_type: "Integration", bypass_mode: "always"}
]')
follower_only=$(jq -n --argjson app "$app_id" '[{actor_id: $app, actor_type: "Integration", bypass_mode: "always"}]')

put() {
  local repo=$1 body=$2 name id
  name=$(jq -r .name <<<"$body")
  if [ "$apply" != "--apply" ]; then
    echo "== $org/$repo ruleset \"$name\""
    jq . <<<"$body"
    return
  fi
  id=$(gh api "repos/$org/$repo/rulesets" --jq ".[] | select(.name == \"$name\") | .id")
  if [ -n "$id" ]; then
    gh api -X PUT "repos/$org/$repo/rulesets/$id" --input - <<<"$body" --jq '"updated \(.name) \(.id)"'
  else
    gh api -X POST "repos/$org/$repo/rulesets" --input - <<<"$body" --jq '"created \(.name) \(.id)"'
  fi
}

unprotect() {
  local repo=$1 branch=$2
  if [ "$apply" != "--apply" ]; then
    echo "== $org/$repo classic protection of $branch, deleted once the rulesets exist"
    gh api "repos/$org/$repo/branches/$branch/protection" | jq '{required_status_checks: .required_status_checks.checks, enforce_admins: .enforce_admins.enabled, allow_force_pushes: .allow_force_pushes.enabled, allow_deletions: .allow_deletions.enabled, required_pull_request_reviews, restrictions}'
    return
  fi
  gh api -X DELETE "repos/$org/$repo/branches/$branch/protection"
  echo "deleted the classic protection of $org/$repo $branch"
}

for repo in ducktape programs app; do
  guarded='["dev"]'
  [ "$repo" = app ] && guarded='["dev", "main"]'
  put "$repo" "$(ruleset "dev: unit check" '["dev"]' "$unit_rules" "$admins_and_follower")"
  put "$repo" "$(ruleset "no force push" "$guarded" '[{"type": "non_fast_forward"}]' "$follower_only")"
  put "$repo" "$(ruleset "no deletion" "$guarded" '[{"type": "deletion"}]' '[]')"
done
for repo in ducktape programs app; do
  unprotect "$repo" dev
done
unprotect app main
