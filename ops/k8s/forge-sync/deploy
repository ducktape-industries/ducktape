#!/usr/bin/env bash
# Builds the forge-sync image around a released ducktape CLI and git-remote-duck, pushes it to the cluster node's registry, and applies forge-sync.yaml.
# Usage: ops/k8s/forge-sync/deploy DUCKTAPE_COMMIT
set -euo pipefail
here="$(cd -- "$(dirname -- "${BASH_SOURCE[0]}")" && pwd)"
usage="usage: ops/k8s/forge-sync/deploy DUCKTAPE_COMMIT"
commit=$(git -C "$here" rev-parse --verify "${1:?$usage}^{commit}")
node=${DEPLOY_NODE:-fabrics@fabrics-1}
context=${DEPLOY_CONTEXT:-fabrics-1}
duck_release=git-remote-duck-7acf453
duck_sha256=c03d7b0d02327af0a1d8eef2d80e778ec8a67850aa42dd2b43022f85269b5b75
tunnel_port=35313

stage=$(mktemp -d)
socket="$stage.ssh"
trap 'ssh -S "$socket" -O exit "$node" 2>/dev/null; rm -rf "$stage"' EXIT
gh release download "bin-$commit" -R ducktape-industries/ducktape \
  -p ducktape-x86_64-unknown-linux-gnu.tar.gz -D "$stage"
tar -xzf "$stage/ducktape-x86_64-unknown-linux-gnu.tar.gz" -C "$stage"
curl -fsSL -o "$stage/git-remote-duck" \
  "https://github.com/ducktape-industries/ducktape/releases/download/$duck_release/git-remote-duck-x86_64-unknown-linux-gnu"
echo "$duck_sha256  $stage/git-remote-duck" | sha256sum --check --quiet
chmod +x "$stage/git-remote-duck"
cp "$here/follower.py" "$stage/follower.py"
tag=$(cat "$here/Containerfile" "$stage/follower.py" <(echo "$commit $duck_release") | sha256sum | cut -c1-12)
podman build --file "$here/Containerfile" --tag "localhost:$tunnel_port/forge-sync:$tag" "$stage"
ssh -fN -M -S "$socket" -o ExitOnForwardFailure=yes -L "127.0.0.1:$tunnel_port:127.0.0.1:5000" "$node"
podman push --tls-verify=false --digestfile "$stage/digest" "localhost:$tunnel_port/forge-sync:$tag"
image="localhost:5000/forge-sync:$tag@$(cat "$stage/digest")"
sed -e "s#@IMAGE@#$image#g" "$here/forge-sync.yaml" | kubectl --context "$context" apply -f -
kubectl --context "$context" -n forge-sync get pods
echo "$image"
