# The forge-sync image: Python with cryptography, git with git-remote-duck, and a released ducktape CLI, running follower.py as uid 1000.
# Built by ops/k8s/forge-sync/deploy from a staged context holding ducktape, git-remote-duck and follower.py.
FROM docker.io/library/debian:trixie-slim
RUN apt-get update && apt-get install -y --no-install-recommends ca-certificates git python3 python3-cryptography \
    && rm -rf /var/lib/apt/lists/* \
    && useradd --uid 1000 --user-group --create-home --home-dir /home/forge-sync forge-sync
COPY ducktape git-remote-duck /usr/local/bin/
COPY follower.py /usr/local/lib/forge-sync/follower.py
ENV NO_COLOR=1 PYTHONDONTWRITEBYTECODE=1 DUCKTAPE_DEVICE_KEY_STORE=file
USER 1000:1000
WORKDIR /home/forge-sync
ENTRYPOINT ["python3", "/usr/local/lib/forge-sync/follower.py"]
