#!/usr/bin/env bash
# Fetches the pinned git-remote-duck release from duckpond's public node as one blob, checks its sha256 and prints the release's name.
# Usage: ops/k8s/git-remote-duck DEST, where DUCK_NODE overrides the node it reads from.
set -euo pipefail
release=git-remote-duck-77f58944
blob=efb88f9ac3fa732a0e90d45884ea6dec71082d5a46ad97ded2ba9672400c3ff6
sha256=f89d91b4a591e743c485639aaeaded5435fa183056d31f04e5eda24e16a2e431
node=${DUCK_NODE:-https://duckpond.ducktape.industries}
dest=${1:?usage: ops/k8s/git-remote-duck DEST}
python3 - "$node" "$blob" "$sha256" "$dest" <<'PY'
import hashlib
import os
import struct
import sys
import urllib.request

node, blob, sha256, dest = sys.argv[1:]
ask = urllib.request.Request(
    f"{node}/v1/blob/get",
    data=b"\x00" + bytes.fromhex(blob),
    method="POST",
    headers={"User-Agent": "ops/k8s/git-remote-duck"},
)
with urllib.request.urlopen(ask) as answered:
    answer = answered.read()
if answer[:1] != b"\x01":
    sys.exit(f"{node} holds no blob {blob}")
(length,) = struct.unpack_from("<I", answer, 1)
framed = answer[5 : 5 + length]
_, nul, body = framed.partition(b"\0")
if len(framed) != length or not nul:
    sys.exit(f"{node} answered blob {blob} cut short")
if hashlib.sha256(body).hexdigest() != sha256:
    sys.exit(f"{node}'s blob {blob} does not hash to {sha256}")
part = f"{dest}.part"
with open(part, "wb") as out:
    out.write(body)
os.chmod(part, 0o755)
os.replace(part, dest)
PY
echo "$release"
