# The pi-chief image: Python and the ducktape CLI built from one forge commit, running pi-chief.py as uid 1000.
# Built by ops/k8s/pi-chief/deploy from a staged context holding `git archive` of that commit under src/ and pi-chief.py.
FROM docker.io/library/rust:1.96.1-trixie AS build
WORKDIR /src
COPY src/ .
RUN cargo build --locked --release -p node-bin

FROM docker.io/library/debian:trixie-slim
ARG COMMIT
LABEL org.opencontainers.image.revision=$COMMIT
RUN apt-get update && apt-get install -y --no-install-recommends ca-certificates python3 \
    && rm -rf /var/lib/apt/lists/* \
    && useradd --uid 1000 --user-group --create-home --home-dir /home/pi-chief pi-chief
COPY --from=build /src/target/release/ducktape /usr/local/bin/ducktape
COPY pi-chief.py /usr/local/lib/pi-chief/pi-chief.py
ENV NO_COLOR=1 PYTHONDONTWRITEBYTECODE=1 DUCKTAPE_DEVICE_KEY_STORE=file
USER 1000:1000
WORKDIR /home/pi-chief
ENTRYPOINT ["python3", "/usr/local/lib/pi-chief/pi-chief.py"]
