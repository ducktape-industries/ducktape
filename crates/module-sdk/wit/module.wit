package ducktape:module@0.1.0;

/// the deterministic host surface a wasm module may touch during dispatch.
/// this is the wasm-boundary twin of `sdk::Ctx`: own-state read/write is
/// host-owned and staged until block commit; cross-module reads are
/// host-routed; writes leave as emitted intents, never reentrant calls.
/// deliberately NO clock / rng / net / direct blob — determinism by omission.
interface host {
  /// Read-only local Git objects. Repository names are confined to this
  /// module's substrate; no filesystem paths, fetches or reference mutations.
  /// The host enforces byte ceilings before materializing object bodies.
  /// a commit as a history walk needs it. `author` is the raw identity line
  /// ("Name <email>"), `committed-at` the committer's epoch seconds — the
  /// committer, not the author, because that is the order a branch was built
  /// in and the order a log is read in. `message` is the WHOLE message; a
  /// walk that wants only the summary takes the first line, which the host
  /// cannot do for it without deciding what a summary is.
  record git-commit {
    tree: list<u8>,
    parents: list<list<u8>>,
    author: string,
    committed-at: u64,
    message: string,
  }
  record git-tree-entry {
    kind: u8,
    name: list<u8>,
    oid: list<u8>,
  }
  variant git-object-data {
    commit(git-commit),
    tree(list<git-tree-entry>),
    blob(list<u8>),
    tag(list<u8>),
  }
  record git-object {
    kind: u8,
    size: u64,
    data: option<git-object-data>,
  }
  /// what happened to one path between the two commits. a closed set: a new
  /// kind must fail the build wherever it is matched rather than fall into a
  /// wildcard that renders it as "modified".
  enum git-file-status {
    added,
    modified,
    deleted,
    renamed,
    type-changed,
  }
  /// one path's row in a diff's index. the index is COMPLETE even when the
  /// patch is not: a reader can always see which files changed and navigate
  /// them, and only the numbers go missing.
  ///
  /// `additions`/`deletions` are absent, not zero, when this file's patch was
  /// never produced — the byte ceiling stopped the walk before it, or the
  /// file's own blobs were too large to examine. a zero that means "unknown"
  /// is a lie a reader cannot detect; `none` cannot be misread. `truncated`
  /// says WHY they are absent.
  record git-diff-file {
    path: string,
    /// the previous path, set only when `status` is `renamed`. NOT spelled
    /// `from`, which is a WIT keyword.
    previous-path: option<string>,
    status: git-file-status,
    additions: option<u64>,
    deletions: option<u64>,
    binary: bool,
    truncated: bool,
  }
  record git-diff {
    patch: string,
    truncated: bool,
    files-changed: u64,
    additions: u64,
    deletions: u64,
    /// every changed path, ordered by path. complete even when `patch` is a
    /// prefix: `files-changed` always equals its length.
    files: list<git-diff-file>,
  }
  variant git-diff-error {
    unavailable(string),
    limit(string),
    unsupported,
  }
  git-object-read: func(repository: string, oid: list<u8>, max-bytes: u64) -> result<git-object, error>;
  /// an EMPTY `target` is a diff against NOTHING, and every path in `source`
  /// comes out `added`. That is what a root commit needs, and it is not the
  /// same read as passing `source` for both, which answers an empty diff. Any
  /// other `target` length is a malformed oid and is refused.
  ///
  /// `path` scopes the read to ONE file. a scoped read resolves that path in
  /// the two trees directly instead of walking the whole pair, so it is bounded
  /// by its own file and never by the aggregate ceilings — which is what makes
  /// it the escape hatch for a change one oversized blob would otherwise make
  /// entirely unreadable. `max-files` is ignored when `path` is set.
  git-diff-read: func(repository: string, target: list<u8>, source: list<u8>, path: option<string>, max-bytes: u64, max-files: u64, max-blob-bytes: u64) -> result<git-diff, git-diff-error>;

  /// the deterministic environment for this dispatch (block-constant fields
  /// are identical on every validator; NOT wall clock, NOT per-node).
  record env {
    height: u64,
    consensus-time: u64,
    me: string,
    origin: origin,
    /// what THIS dispatch descends from (`sdk::Cause`).
    cause: cause,
  }

  /// who triggered THIS dispatch. `program` is a program account the host
  /// proved live and executed by the requesting module before the call unit
  /// ran — an identity, never a credential.
  variant origin {
    external(list<u8>),
    from-module(string),
    program(u64),
    system,
  }

  /// the identity of one call a module queued: `(requester, invocation,
  /// step)`, immutable once queued (`sdk::CallId`).
  record call-id {
    requester: string,
    invocation: string,
    step: u64,
  }

  /// one item in a source module's outbound queue (`sdk::ItemRef`).
  record item-ref {
    source: string,
    item: u64,
  }

  /// one record of a source's own change log that several deliveries fan
  /// out from (`sdk::Root::Change`).
  record change-ref {
    source: string,
    seq: u64,
  }

  /// where a causal chain started (`sdk::Root`).
  variant root {
    item(item-ref),
    call(call-id),
    change(change-ref),
  }

  /// the latest link of a causal chain (`sdk::Hop`).
  variant hop {
    delivery(item-ref),
    call(call-id),
    completion(call-id),
  }

  /// a chain's root and latest link.
  record chain {
    root: root,
    hop: hop,
  }

  /// the causal context of one dispatch (`sdk::Cause`): a submitted op or
  /// host injection, or a link the host ran on a module's behalf.
  variant cause {
    direct,
    chain(chain),
  }

  /// one queued item as a source reports it (`sdk::PendingItem`).
  record pending-item {
    item: u64,
    target: string,
    payload: list<u8>,
    cause: cause,
  }

  /// how a delivery ended, as the host reports it (`sdk::DeliveryOutcome`).
  variant delivery-outcome {
    applied,
    failed(string),
    unrepresentable,
  }

  /// the host's acknowledgment of one delivery (`sdk::Ack`).
  record ack {
    item: u64,
    target: string,
    outcome: delivery-outcome,
  }

  /// the deterministic error a module may surface. `rejected` is a clean,
  /// deterministic no-op-on-every-honest-validator failure.
  variant error {
    rejected(string),
    unknown-module(string),
    self-query,
    unsupported,
    sync-unsupported,
    swap-unsupported,
    budget-exceeded,
  }

  /// where a module's COMMITTED state lives: the substrate the host wraps
  /// the component over and computes `root()` from. a property of the code
  /// — the same bytes always want the same substrate — so the component
  /// declares it (`module-shape`) and the host refuses any other.
  enum backing {
    /// a host-owned key/value map: root = sha256 over the canonical
    /// encoding, sync = installable snapshot bytes. any key shape. (`map`
    /// is a WIT keyword, hence the escape; the name is `map`.)
    %map,
    /// a host-constructed authenticated store (qmdb): root = the store's
    /// merkle root, sync = the store's resolver lane. every state key is a
    /// 32-byte digest.
    store,
    /// Content-addressed objects and a durable refs image. Queries run the guest.
    odb,
    /// Git object storage and a durable refs image. Queries run the guest.
    git,
  }

  /// what the host must know to run this component. read once from the
  /// bytes on every path a module enters a host (genesis, admission, a
  /// reopen, a code swap), before they are wrapped over a substrate.
  record module-shape {
    backing: backing,
    /// the per-network genesis parameters the host seeds into this module's
    /// reserved `__config` record when it starts fresh (`chain_id`,
    /// `invite`); empty = not network-bound.
    config: list<string>,
    /// the query lane answers from committed state alone, regardless of
    /// caller: for a module whose between-block reads must never observe a
    /// same-block staged write.
    committed-queries: bool,
  }

  /// deterministic environment for this dispatch.
  get-env: func() -> env;

  /// own authenticated state. the host owns the store and computes this
  /// module's root() from it; writes are staged and only published at the
  /// block-commit boundary (discarded on abort).
  state-get: func(key: list<u8>) -> option<list<u8>>;
  /// Read the preceding block's committed state, bypassing staged writes.
  state-get-committed: func(key: list<u8>) -> option<list<u8>>;
  /// Warm committed reads together; ordinary reads still honor their overlay.
  /// Missing records remain absent, and distinct keys share the read budget.
  state-prefetch: func(keys: list<list<u8>>);
  state-set: func(key: list<u8>, value: list<u8>);
  state-delete: func(key: list<u8>);

  /// snapshot root of a sibling module as of the START of this dispatch.
  module-root: func(target: string) -> option<list<u8>>;
  /// live, read-only, host-routed read of a sibling module.
  query-module: func(target: string, req: list<u8>) -> result<list<u8>, error>;

  // ---- object plane -------------------------------------------------------
  // a content-addressed object store the host owns beside this module's own
  // state (duckfs's odb behind the host boundary — NOT a shared byte plane;
  // duckfs-private in intent even though the surface is world-level). the
  // determinism envelope is BY OMISSION, exactly like the rest of this world:
  //   * READS (`object-stat` / `object-get`) resolve ONLY refs-reachable
  //     structural objects — consensus-uniform bytes every honest validator
  //     possesses — plus this block's own staged puts. an id no validator can
  //     reach answers `none` identically everywhere (never a per-node fork).
  //   * WRITES (`object-put`) are STAGED effects: visible to same-block
  //     stat/get immediately, published (or discarded) at the real block
  //     boundary with duckfs's durability ordering (objects → sync → refs).
  // an id is `sha256(kind-tag ‖ body)`, so a put's answer is a pure function of
  // its inputs — the same on every validator, which is what lets a staged put
  // feed the same-dispatch read overlay without a consensus round.

  /// metadata-only read: `(kind-tag, body-byte-length)` of a refs-reachable
  /// object (or this block's staged put), or `none` if absent. answered from
  /// metadata alone — NEVER a full body read on the consensus path (the duckfs
  /// stat contract). a memo miss pauses the run for the host to resolve.
  object-stat: func(id: list<u8>) -> option<tuple<u8, u64>>;
  /// full read: the TAGGED body `kind-tag ‖ body` of a refs-reachable object
  /// (or this block's staged put), or `none` if absent. a memo miss pauses the
  /// run for the host to resolve against the committed object store.
  object-get: func(id: list<u8>) -> option<list<u8>>;
  /// stage a put and return its 32-byte id. the host computes
  /// `id = sha256(kind-tag ‖ body)` and returns the id ALONE — a hash mismatch
  /// is impossible when the host computes it, so this cannot fail here; the
  /// fail-closed verification belongs where a STAGED put is later PUBLISHED
  /// against an id (the disk backing's block-boundary publish). the staged put
  /// is visible to same-block `object-stat` / `object-get` and is discarded if
  /// the block aborts.
  object-put: func(kind: u8, body: list<u8>) -> list<u8>;

  /// emit a write intent — re-dispatched as a follow-up op, never reentrant.
  emit-msg: func(target: string, payload: list<u8>);
  /// declare this op's output — staged with the op, capped by the host at
  /// `sdk::MAX_OUTPUT_BYTES` (exceeding it rejects the op), last write wins
  /// within one dispatch. a call unit's output rides its completion back to
  /// the requester.
  set-output: func(bytes: list<u8>);
  /// emit an observability event — leaves the state machine.
  emit-event: func(source: string, payload: list<u8>);
  /// declare this dispatch's assigned stamp — values the module ASSIGNED
  /// applying this op (a sequence, a revision), recorded on the dispatch
  /// trace and carried on the derived-tier op-feed row. module-encoded,
  /// host-opaque; last write wins within one dispatch.
  set-assigned: func(stamp: list<u8>);
}

/// the contract every wasm module implements. the guest is PURE logic over
/// the host surface; it owns no durable memory across dispatches (the host
/// re-instantiates per call), so state lives entirely behind `host.state-*`.
world module {
  use host.{ack, error, module-shape, pending-item};
  import host;

  /// this component's shape: what the host must know to run it. a pure
  /// constant of the code — it touches no import (the host reads it outside
  /// any dispatch, with no env set) and never changes between two calls.
  export shape: func() -> module-shape;
  /// Initialize fresh state from caller-supplied parameters. State writes are
  /// staged atomically; initialization cannot emit follow-up operations.
  export initialize: func(params: list<u8>) -> result<_, error>;
  /// Complete this block's state changes before the host publishes its store.
  /// Called once for each dispatched module, never on an aborted block.
  export finalize-block: func() -> result<_, error>;
  /// dispatch entry: apply an incoming op payload addressed to this module.
  export execute: func(payload: list<u8>) -> result<_, error>;
  /// read-only projection of this module's state.
  export query: func(req: list<u8>) -> result<list<u8>, error>;
  /// the head of this module's COMMITTED outbound queue, in delivery order
  /// (`sdk::Module::pending_items`). the host runs it in a committed-only
  /// round; a read or decode failure is an error, never an empty queue.
  export pending-items: func() -> result<list<pending-item>, error>;
  /// retire one queued item with the host's acknowledgment of its delivery
  /// (`sdk::Module::acknowledge`). runs like `execute`: staged writes,
  /// committed or aborted with the delivery unit.
  export acknowledge: func(ack: ack) -> result<_, error>;
}
